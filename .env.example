# Required: your Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Optional: max video size in MB before falling back to a link (default: 50)
MAX_FILE_SIZE_MB=50

# Optional: temp directory for downloaded videos (default: /tmp/tiktok)
TEMP_DIR=/tmp/tiktok

# Optional: directory for the bot's database (likes/views, remembered TikTok topic)
DATA_DIR=/app/data

# Optional: thread ID of the TikTok topic in a group with topics. Videos from links
# posted anywhere in the group go there. Usually not needed: the bot finds a topic named
# "TikTok" by itself, or an admin can send /topic_id inside the topic to pick it.
TIKTOK_TOPIC_ID=
